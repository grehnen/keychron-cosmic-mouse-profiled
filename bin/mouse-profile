#!/usr/bin/env python3
"""Switch the Keychron G6 HE 8K mouse profile (via TurboLink 8K receiver or cable).

Usage: mouse-profile <index>   (0 = first profile, 1 = second, ...)
Protocol captured from launcher.keychron.com: output report 0xb5 on the
vendor interface (usage page 0xffc1), payload 0e <index> <profile_count>.
"""
import glob, os, sys

KEYCHRON_VID = 0x3434
VENDOR_USAGE_PAGE_DESCRIPTOR = bytes([0x06, 0xC1, 0xFF])  # Usage Page (0xFFC1)
REPORT_ID = 0xB5
PAYLOAD_LEN = 20
PROFILE_COUNT = int(os.environ.get("MOUSE_PROFILE_COUNT", "2"))


def find_vendor_hidraw():
    for sys_dir in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        with open(f"{sys_dir}/device/uevent") as uevent:
            props = dict(line.strip().split("=", 1) for line in uevent if "=" in line)
        vid = int(props.get("HID_ID", "0:0:0").split(":")[1], 16)
        if vid != KEYCHRON_VID or "Keychron" not in props.get("HID_NAME", ""):
            continue
        if "K10" in props.get("HID_NAME", ""):
            continue
        with open(f"{sys_dir}/device/report_descriptor", "rb") as rd:
            if VENDOR_USAGE_PAGE_DESCRIPTOR in rd.read():
                return "/dev/" + os.path.basename(sys_dir)
    return None


def main():
    if len(sys.argv) != 2 or not sys.argv[1].isdigit():
        sys.exit(__doc__)
    index = int(sys.argv[1])
    if index >= PROFILE_COUNT:
        sys.exit(f"profile index {index} out of range (count {PROFILE_COUNT})")
    device = find_vendor_hidraw()
    if not device:
        sys.exit("Keychron mouse vendor interface not found")
    payload = bytes([0x0E, index, PROFILE_COUNT]).ljust(PAYLOAD_LEN, b"\0")
    with open(device, "wb", buffering=0) as hid:
        hid.write(bytes([REPORT_ID]) + payload)


if __name__ == "__main__":
    main()
