# mouse-profile config. Edits apply on the next focus change, no restart needed.
# Profiles are numbered from 0 (0 = first, 1 = second, ...).

# Number of profiles set up on the mouse ("Levels" in the Keychron launcher, 1–5).
# Defaults to 2 if this line is missing or commented out.
# profiles = 2

# Profile for every app without its own rule below.
default = 0

# Profile per app: <app_id> = <profile>. App IDs are case-insensitive;
# find them with:  journalctl --user -u mouse-profiled -f
# gamescope = 1
# steam_app_730 = 1
